### 1. ทดสอบสร้างงาน
POST http://localhost:3000/tasks
Content-Type: application/json

{
    "title": "เขียนโค้ดด้วย Mongoose"
}

### 2. ทดสอบดึงข้อมูล (ก๊อปปี้ id จากตรงนี้)
GET http://localhost:3000/tasks

### 3. ทดสอบแก้ไข (เอา id มาต่อท้าย URL)
PUT http://localhost:3000/tasks/6ac3ca1db509d959070e6116


### 4. ทดสอบลบ (เอา id มาต่อท้าย URL)
###DELETE http://localhost:3000/tasks/6ac3ca88b509d959070e6118
DELETE http://localhost:3000/tasks/1234567890abcdef


### ข้อ 11 ทดสอบสมัครสมาชิก
POST http://localhost:3000/register
Content-Type: application/json

{
    "username": "admin",
    "password": "password123"
}

### ข้อ 12 ทดสอบการล็อกอิน
POST http://localhost:3000/login
Content-Type: application/json

{
    "username": "admin",
    "password": "password123"
}

